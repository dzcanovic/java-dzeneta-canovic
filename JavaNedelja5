package novi;
import java.util.ArrayList;
public class Destinacija {
	
	private String naziv;
	private String drzava;
	private int ocjena;
	private int udaljenost;
	private int brojPosjeta;
	
	

	public Destinacija(String naziv, String drzava, int ocjena, int udaljenost, int brojPosjeta) {
		
		this.naziv = naziv;
		this.drzava = drzava;
		this.ocjena = ocjena;
		this.udaljenost = udaljenost;
		this.brojPosjeta = brojPosjeta;
	}
	
    





	public String getNaziv() {
		return naziv;
	}




	public void setNaziv(String naziv) {
		this.naziv = naziv;
	}




	public String getDrzava() {
		return drzava;
	}




	public void setDrzava(String drzava) {
		this.drzava = drzava;
	}




	public int getOcjena() {
		return ocjena;
	}




	public void setOcjena(int ocjena) {
		this.ocjena = ocjena;
	}




	public int getUdaljenost() {
		return udaljenost;
	}




	public void setUdaljenost(int udaljenost) {
		this.udaljenost = udaljenost;
	}




	public int getBrojPosjeta() {
		return brojPosjeta;
	}




	public void setBrojPosjeta(int brojPosjeta) {
		this.brojPosjeta = brojPosjeta;
	}

