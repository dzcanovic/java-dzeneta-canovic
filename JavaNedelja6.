				+ getGodinaProizvodnje() + ", UvoznaCijena()=" + getUvoznaCijena() + "]";
	}
	
	
	

}
//Hemijski proizvodi
package klase;

public class HemijiskiProizvodi extends Proizvodi {
	private double temperaturaSkladistenja;
	private boolean zapaljivo;
	public double getTemperaturaSkladistenja() {
		return temperaturaSkladistenja;
	}
	public void setTemperaturaSkladistenja(double temperaturaSkladistenja) {
		this.temperaturaSkladistenja = temperaturaSkladistenja;
	}
	public boolean isZapaljivo() {
		return zapaljivo;
	}
	public void setZapaljivo(boolean zapaljivo) {
		this.zapaljivo = zapaljivo;
	}
	
	public HemijiskiProizvodi(String opisProizvoda, int barKod, String zemljaPorijekla, int godinaProizvodnje,
			int uvoznaCijena, double temperaturaSkladistenja, boolean zapaljivo) {
		super(opisProizvoda, barKod, zemljaPorijekla, godinaProizvodnje, uvoznaCijena);
		this.temperaturaSkladistenja = temperaturaSkladistenja;
		this.zapaljivo = zapaljivo;
	}
	
	public void izracunajCijenu() {
		if(this.zapaljivo) {
			this.setUvoznaCijena(getUvoznaCijena()*1.125);
		}else {
			this.setUvoznaCijena(getUvoznaCijena()*1.1);
		}
	}
	@Override
	public String toString() {
		return "HemijiskiProizvodi [temperaturaSkladistenja=" + temperaturaSkladistenja + ", zapaljivo=" + zapaljivo
				+ ", TemperaturaSkladistenja=" + getTemperaturaSkladistenja() + ", Zapaljivo=" + isZapaljivo()
				+ ", OpisProizvoda=" + getOpisProizvoda() + ", BarKod=" + getBarKod()
				+ ", ZemljaPorijekla()=" + getZemljaPorijekla() + ", GodinaProizvodnje="
				+ getGodinaProizvodnje() + ", UvoznaCijena=" + getUvoznaCijena() + "]";
	}
	
	
	
	

}
