
public class Razlomak {

	private int imenilac;
	private int brojilac;
	
	public Razlomak(int imenilac, int brojilac) {
		super();
		this.setImenilac(imenilac);
		this.setBrojilac(brojilac);
	}
	
	
	public Razlomak() {
		this(1,0);
	}
	
	
	public int getImenilac() {
		return imenilac;
	}
	public void setImenilac(int imenilac) {
		this.imenilac = imenilac;
	}
	public int getBrojilac() {
		return brojilac;
	}
	public void setBrojilac(int brojilac) {
		this.brojilac = brojilac;
	}


	@Override
	public String toString() {
		
		if(this.getBrojilac() >= 0 && this.getImenilac() >= 0) {
			return String.format("%d/%d", this.getBrojilac(),this.getImenilac());
	}else if(this.getBrojilac() < 0 && this.getImenilac() >= 0) {
		return String.format("%d/%d", this.getBrojilac(),this.getImenilac());
	}else if(this.getBrojilac() >= 0 && this.getImenilac() < 0) {
		return String.format("%d/%d", this.getBrojilac(),this.getImenilac());
	}else {
	    return String.format("%d/%d", getBrojilac(), getImenilac());
	}
	}
		public void skrati() {
			for(int i = 2; i<= Math.min(Math.abs(this.getBrojilac()),Math.abs(this.getImenilac()));i++) {

				while(this.getBrojilac()% i == 0 && this.getImenilac() % i == 0) {
					this.imenilac /= i;
					this.brojilac /= i;
				}
				}
			}
	public static Razlomak saberi(Razlomak a, Razlomak b) {
		Razlomak r = new Razlomak(a.getImenilac() * b.getImenilac(), a.getBrojilac() * b.getImenilac()+ a.getImenilac() * b.getBrojilac());
		r.skrati();
		return r;
	}
	public static Razlomak mnozi(Razlomak a, Razlomak b) {
		Razlomak r = new Razlomak( a.getImenilac() * b.getImenilac(), a.getBrojilac() * b.getBrojilac());
		r.skrati();
		return r;
	}
	public static Razlomak oduzmi(Razlomak a, Razlomak b) {
		Razlomak r = new Razlomak(a.getImenilac() * b.getImenilac(),  a.getBrojilac() * b.getImenilac() - a.getImenilac() * b.getBrojilac());
		r.skrati();
		return r;
	
}
	public static Razlomak podijeli(Razlomak a, Razlomak b){
		Razlomak r = new Razlomak();
		r.setBrojilac(a.getBrojilac()*b.getImenilac());
		r.setImenilac(a.getImenilac()*b.getBrojilac());
		return r;
		}
	}
